package views

import "encoding/json"
import "falkcroche/modelos"
import "fmt"
import "strconv"
import "strings"
import "time"

templ PedidosLista(pedidos []modelos.Pedido, clientes []modelos.Cliente, produtos []modelos.Produto) {
<div class="space-y-6">
	<div class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center sm:gap-4">
		<div>
			<h3 class="text-xl font-serif font-bold text-[#5a262c]">Pedidos do ateliê</h3>
			<p class="text-sm text-[#5a262c]/60">Acompanhe cada encomenda até a entrega.</p>
		</div>
		<button id="abrir-modal-pedido" type="button"
			class="shrink-0 rounded-lg bg-[#5a262c] px-4 py-2.5 text-sm font-bold text-[#ffeae8] hover:bg-[#472025] transition-colors">Novo
			pedido</button>
	</div>

	<dialog id="modal-pedido"
		class="w-[min(42rem,calc(100%-2rem))] max-w-none rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-[#2b1719]/50">
		<div class="max-h-[90vh] overflow-y-auto bg-white p-4 sm:p-8">
			<div class="flex items-start justify-between gap-4 mb-6">
				<div>
					<p class="text-sm font-semibold text-[#c17f6b] mb-1">Nova encomenda</p>
					<h3 class="text-2xl font-serif font-bold">Registrar pedido</h3>
				</div>
				<button id="fechar-modal-pedido" type="button" aria-label="Fechar"
					class="rounded-full px-3 py-1 text-2xl text-[#5a262c]/60 hover:bg-[#ffeae8]">&times;</button>
			</div>
			<form method="POST" action="/pedidos/inserir" class="space-y-5">
				<div class="relative z-40" id="cliente-campo">
					<label for="cliente-busca" class="mb-1.5 block text-sm font-semibold">Cliente</label>
					<input id="cliente-busca" type="search" autocomplete="off" required
						placeholder="Digite o nome ou WhatsApp"
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
					<input id="cliente-id" type="hidden" name="cliente_id" />
					<div id="cliente-opcoes"
						class="absolute z-20 mt-1 hidden max-h-48 w-full overflow-y-auto rounded-lg border border-[#e8d5c4] bg-white p-1 shadow-lg">
						for _, c := range clientes {
						<button type="button" data-opcao-cliente data-id={ fmt.Sprintf("%d", c.ID) } data-label={ c.Nome
							} data-busca={ c.Nome + " " + c.Whatsapp }
							class="block w-full rounded-md px-3 py-2 text-left text-sm hover:bg-[#ffeae8]">
							<strong>{ c.Nome }</strong>
							if c.Whatsapp != "" {
							<span class="ml-2 text-[#5a262c]/60">{ c.Whatsapp }</span>
							}
						</button>
						}
						<p id="cliente-sem-resultado" class="hidden px-3 py-2 text-sm text-[#5a262c]/60">Nenhum cliente
							encontrado.</p>
					</div>
					if len(clientes) == 0 {
					<p class="mt-2 text-xs text-[#c17f6b]">Cadastre um cliente antes de criar o pedido.</p>
					}
				</div>

				<div>
					<label for="produto-busca" class="mb-1.5 block text-sm font-semibold">Produtos do orçamento</label>
					<div class="relative z-30">
						<input id="produto-busca" type="search" autocomplete="off" aria-controls="produto-opcoes" aria-expanded="false" placeholder="Digite para buscar um produto"
							class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
						<div id="produto-opcoes" class="absolute left-0 right-0 top-full z-30 mt-1 hidden max-h-48 overflow-y-auto rounded-lg border border-[#e8d5c4] bg-white shadow-lg">
						for _, p := range produtos {
						<button type="button" data-opcao-produto data-id={ fmt.Sprintf("%d", p.ID) } data-nome={ p.NomePeca } data-preco={ fmt.Sprintf("%g", p.Preco) }
							class="block w-full border-b border-[#e8d5c4] px-3 py-2.5 text-left text-sm last:border-0 hover:bg-[#fcf9f8]">
							<strong>{ p.NomePeca }</strong><span class="ml-2 text-xs text-[#5a262c]/60">{ FormatarReais(p.Preco) }</span><span data-acao-produto class="float-right text-xs font-semibold text-[#5a262c]"></span>
						</button>
						}
						<p data-sem-produto class="hidden px-3 py-2.5 text-sm text-[#5a262c]/60">Nenhum produto encontrado.</p>
						</div>
					</div>
					<div id="produto-itens" class="mt-3 space-y-2" aria-live="polite"></div>
					if len(produtos) == 0 {
					<p class="mt-2 text-xs text-[#c17f6b]">Cadastre um produto antes de criar o pedido.</p>
					}
				</div>

				<label for="pedido-brinde" class="flex items-start gap-2 rounded-lg border border-[#e8d5c4] p-4 text-sm font-semibold">
					<input id="pedido-brinde" name="pedido_brinde" data-pedido-brinde type="checkbox" class="mt-0.5 size-4 shrink-0 accent-[#5a262c]" />
					<span>Este pedido é um brinde: valor R$ 0,00 e sem cobrança.</span>
				</label>
				<div id="pedido-principal-container" hidden>
					<label for="pedido-principal" class="mb-1.5 block text-sm font-semibold">Pedido principal (opcional)</label>
					<select id="pedido-principal" name="pedido_principal_id" disabled
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20">
						<option value="">Sem vínculo com outro pedido</option>
						for _, principal := range pedidos {
						if !principal.Brinde {
						<option value={ fmt.Sprintf("%d", principal.ID) }>
							{ fmt.Sprintf("#%d · %s · %s", principal.ID, obterNomeCliente(principal.ClienteID, clientes), nomesItensPedido(principal)) }
						</option>
						}
						}
					</select>
				</div>
				<p class="rounded-lg bg-[#7a8c5f]/10 px-4 py-3 text-sm text-[#56653f]" data-aviso-pedido-brinde hidden>
					O brinde será registrado diretamente em produção, com valor zero e sem gerar parcelas ou lançamentos financeiros.
				</p>

				<p class="rounded-lg bg-[#ffeae8]/60 px-4 py-3 text-sm text-[#5a262c]/80">Prazo de produção: <strong>20
						dias úteis</strong>, com previsão calculada automaticamente.</p>

				<fieldset id="opcoes-orcamento-pedido">
					<legend class="mb-2 text-sm font-bold text-[#5a262c]">Opções do orçamento</legend>
					<div class="divide-y divide-[#e8d5c4] rounded-lg border border-[#e8d5c4] bg-white">
						<label for="desconto-pix-avista" class="flex items-center gap-2 p-4 text-sm font-semibold">
							<input id="desconto-pix-avista" name="desconto_pix_avista" type="checkbox" checked class="size-4 shrink-0 accent-[#5a262c]" />
							<span>Aplicar desconto de 10% no Pix à vista</span>
						</label>
						<div class="grid grid-cols-1 gap-3 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
							<label for="tem-desconto-cartao" class="flex items-center gap-2 text-sm font-semibold">
								<input id="tem-desconto-cartao" name="tem_desconto" type="checkbox" class="size-4 shrink-0 accent-[#5a262c]" />
								<span>Desconto no cartão de crédito</span>
							</label>
							<div class="flex flex-wrap items-center gap-3 sm:justify-self-end">
								<label for="percentual-desconto" class="text-sm">Percentual</label>
								<input id="percentual-desconto" name="percentual_desconto" type="number" min="0.01" max="100" step="0.01" placeholder="Ex.: 10" aria-label="Percentual de desconto no cartão" class="w-24 rounded-md border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
								<span class="text-sm font-semibold">%</span>
							</div>
						</div>

						<div class="p-4">
							<label for="pix-parcelado" class="flex items-start gap-2 text-sm font-semibold">
								<input id="pix-parcelado" name="pix_parcelado" type="checkbox" class="mt-0.5 size-4 shrink-0 accent-[#5a262c]" />
								<span>Oferecer Pix parcelado (30% de sinal + até 3 parcelas)</span>
							</label>
							<div class="mt-3 grid grid-cols-1 gap-3 border-l-2 border-[#e8d5c4] pl-4 sm:ml-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
								<label for="tem-desconto-pix-parcelado" class="flex items-center gap-2 text-sm">
									<input id="tem-desconto-pix-parcelado" name="tem_desconto_pix_parcelado" type="checkbox" class="size-4 shrink-0 accent-[#5a262c]" />
									<span>Aplicar desconto nessa modalidade</span>
								</label>
								<div class="flex flex-wrap items-center gap-3 sm:justify-self-end">
									<label for="percentual-desconto-pix-parcelado" class="text-sm">Percentual</label>
									<input id="percentual-desconto-pix-parcelado" name="percentual_desconto_pix_parcelado" type="number" min="0.01" max="100" step="0.01" placeholder="Ex.: 5" aria-label="Percentual de desconto no Pix parcelado" class="w-24 rounded-md border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
									<span class="text-sm font-semibold">%</span>
								</div>
							</div>
						</div>

						<label for="incluir-brinde" class="flex items-center gap-2 p-4 text-sm font-semibold">
							<input id="incluir-brinde" name="incluir_brinde" type="checkbox" class="size-4 shrink-0 accent-[#5a262c]" />
							<span>Incluir brinde pequeno nas cores escolhidas</span>
						</label>
					</div>
				</fieldset>

				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					<div>
						<label for="linha-cores-nome" class="mb-1.5 block text-sm font-semibold">Linha de fios para este
							orçamento</label>
						<input id="linha-cores-nome" name="linha_cores_nome" type="text"
							placeholder="Ex.: Amigurumi Soft"
							class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
					</div>
					<div>
						<label for="linha-cores-link" class="mb-1.5 block text-sm font-semibold">Link da tabela oficial
							de cores</label>
						<input id="linha-cores-link" name="linha_cores_link" type="url" placeholder="https://..."
							class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
					</div>
				</div>

				<div>
					<label for="data-pedido" class="mb-1.5 block text-sm font-semibold">Data do pedido</label>
					<input id="data-pedido" name="data_pedido" type="date"
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
					<p class="mt-1 text-xs text-[#5a262c]/60">Preencha para registrar uma encomenda antiga; se deixar em branco, será usada a data de hoje.</p>
				</div>
				<div>
					<label for="observacoes-pedido" class="mb-1.5 block text-sm font-semibold">Detalhes do
						pedido</label>
					<textarea id="observacoes-pedido" name="observacoes" rows="3"
						placeholder="Cores, tamanho ou outros detalhes"
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20"></textarea>
				</div>
				<div class="flex flex-col-reverse justify-end gap-2 border-t border-[#e8d5c4] pt-5 sm:flex-row sm:gap-3">
					<button id="cancelar-modal-pedido" type="button"
						class="rounded-lg border border-[#e8d5c4] px-4 py-2.5 text-sm font-semibold hover:bg-[#ffeae8]">Cancelar</button>
					<button id="criar-pedido-submit" type="submit"
						class="rounded-lg bg-[#5a262c] px-5 py-2.5 text-sm font-bold text-[#ffeae8] hover:bg-[#472025]">Criar
						orçamento</button>
				</div>
			</form>
		</div>
	</dialog>

	<dialog id="modal-editar-pedido"
		class="w-[min(38rem,calc(100%-2rem))] max-w-none rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-[#2b1719]/50">
		<div class="max-h-[90vh] overflow-y-auto bg-white p-4 sm:p-8">
			<div class="mb-6 flex items-start justify-between gap-4">
				<div>
					<p class="mb-1 text-sm font-semibold text-[#c17f6b]">Pedido</p>
					<h3 class="text-2xl font-serif font-bold text-[#5a262c]">Editar pedido</h3>
					<p class="mt-1 text-sm text-[#5a262c]/70">Pedidos com pagamentos mantêm as condições financeiras registradas.</p>
				</div>
				<button id="fechar-modal-editar-pedido" type="button" aria-label="Fechar"
					class="rounded-full px-3 py-1 text-2xl text-[#5a262c]/60 hover:bg-[#ffeae8]">&times;</button>
			</div>
			<form id="form-editar-pedido" method="POST" action="/pedidos/atualizar" class="space-y-5">
				<input id="editar-pedido-id" type="hidden" name="pedido_id" />
				<div>
					<label for="editar-pedido-cliente" class="mb-1.5 block text-sm font-semibold">Cliente</label>
					<select id="editar-pedido-cliente" name="cliente_id" required
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20">
						for _, cliente := range clientes {
						<option value={ fmt.Sprintf("%d", cliente.ID) }>{ cliente.Nome }</option>
						}
					</select>
				</div>
				<div>
					<label for="editar-produto-busca" class="mb-1.5 block text-sm font-semibold">Produtos do orçamento</label>
					<div class="relative z-30">
						<input id="editar-produto-busca" type="search" autocomplete="off" aria-controls="editar-produto-opcoes" aria-expanded="false" placeholder="Digite para buscar um produto"
							class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
						<div id="editar-produto-opcoes" class="absolute left-0 right-0 top-full z-30 mt-1 hidden max-h-48 overflow-y-auto rounded-lg border border-[#e8d5c4] bg-white shadow-lg">
						for _, produto := range produtos {
						<button type="button" data-opcao-produto data-id={ fmt.Sprintf("%d", produto.ID) } data-nome={ produto.NomePeca } data-preco={ fmt.Sprintf("%g", produto.Preco) }
							class="block w-full border-b border-[#e8d5c4] px-3 py-2.5 text-left text-sm last:border-0 hover:bg-[#fcf9f8]">
							<strong>{ produto.NomePeca }</strong><span class="ml-2 text-xs text-[#5a262c]/60">{ FormatarReais(produto.Preco) }</span><span data-acao-produto class="float-right text-xs font-semibold text-[#5a262c]"></span>
						</button>
						}
						<p data-sem-produto class="hidden px-3 py-2.5 text-sm text-[#5a262c]/60">Nenhum produto encontrado.</p>
						</div>
					</div>
					<div id="editar-produto-itens" class="mt-3 space-y-2" aria-live="polite"></div>
				</div>
				<label for="editar-pedido-brinde" class="flex items-start gap-2 rounded-lg border border-[#e8d5c4] p-4 text-sm font-semibold">
					<input id="editar-pedido-brinde" name="pedido_brinde" type="checkbox" class="mt-0.5 size-4 shrink-0 accent-[#5a262c]" />
					<span>Este pedido é um brinde: valor R$ 0,00 e sem cobrança.</span>
				</label>
				<div id="editar-pedido-principal-container" hidden>
					<label for="editar-pedido-principal" class="mb-1.5 block text-sm font-semibold">Pedido principal (opcional)</label>
					<select id="editar-pedido-principal" name="pedido_principal_id" disabled
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20">
						<option value="">Sem vínculo com outro pedido</option>
						for _, principal := range pedidos {
						if !principal.Brinde {
						<option value={ fmt.Sprintf("%d", principal.ID) } data-pedido-id={ fmt.Sprintf("%d", principal.ID) }>{ fmt.Sprintf("#%d · %s · %s", principal.ID, obterNomeCliente(principal.ClienteID, clientes), nomesItensPedido(principal)) }</option>
						}
						}
					</select>
				</div>
				<fieldset id="editar-opcoes-orcamento" class="space-y-3 rounded-lg border border-[#e8d5c4] p-4">
					<legend class="px-1 text-sm font-bold text-[#5a262c]">Opções do orçamento</legend>
					<div id="editar-opcoes-financeiras" class="space-y-3">
						<label for="editar-desconto-pix-avista" class="flex items-center gap-2 text-sm font-semibold">
							<input id="editar-desconto-pix-avista" name="desconto_pix_avista" type="checkbox" class="size-4 shrink-0 accent-[#5a262c]" />
							<span>Aplicar desconto de 10% no Pix à vista</span>
						</label>
						<div class="flex flex-wrap items-center gap-3">
							<label for="editar-tem-desconto-cartao" class="flex items-center gap-2 text-sm font-semibold">
								<input id="editar-tem-desconto-cartao" name="tem_desconto" type="checkbox" class="size-4 shrink-0 accent-[#5a262c]" />
								<span>Desconto no cartão</span>
							</label>
							<label for="editar-percentual-desconto" class="text-sm">Percentual</label>
							<input id="editar-percentual-desconto" name="percentual_desconto" type="number" min="0.01" max="100" step="0.01" class="w-24 rounded-md border border-[#e8d5c4] bg-[#fcf9f8] px-2 py-1.5" />
							<span class="text-sm font-semibold">%</span>
						</div>
						<label for="editar-pix-parcelado" class="flex items-start gap-2 text-sm font-semibold">
							<input id="editar-pix-parcelado" name="pix_parcelado" type="checkbox" class="mt-0.5 size-4 shrink-0 accent-[#5a262c]" />
							<span>Oferecer Pix parcelado (30% de sinal + até 3 parcelas)</span>
						</label>
						<div class="flex flex-wrap items-center gap-3 border-l-2 border-[#e8d5c4] pl-4">
							<label for="editar-tem-desconto-pix-parcelado" class="flex items-center gap-2 text-sm">
								<input id="editar-tem-desconto-pix-parcelado" name="tem_desconto_pix_parcelado" type="checkbox" class="size-4 shrink-0 accent-[#5a262c]" />
								<span>Desconto no Pix parcelado</span>
							</label>
							<label for="editar-percentual-desconto-pix-parcelado" class="text-sm">Percentual</label>
							<input id="editar-percentual-desconto-pix-parcelado" name="percentual_desconto_pix_parcelado" type="number" min="0.01" max="100" step="0.01" class="w-24 rounded-md border border-[#e8d5c4] bg-[#fcf9f8] px-2 py-1.5" />
							<span class="text-sm font-semibold">%</span>
						</div>
					</div>
					<label for="editar-incluir-brinde" class="flex items-center gap-2 text-sm font-semibold">
						<input id="editar-incluir-brinde" name="incluir_brinde" type="checkbox" class="size-4 shrink-0 accent-[#5a262c]" />
						<span>Incluir brinde pequeno nas cores escolhidas</span>
					</label>
					<p id="editar-opcoes-bloqueadas" class="text-xs text-[#5a262c]/60" hidden>As condições financeiras não podem ser alteradas depois que pagamentos forem gerados.</p>
				</fieldset>
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					<div>
						<label for="editar-linha-cores-nome" class="mb-1.5 block text-sm font-semibold">Linha de fios para este orçamento</label>
						<input id="editar-linha-cores-nome" name="linha_cores_nome" type="text" class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3" />
					</div>
					<div>
						<label for="editar-linha-cores-link" class="mb-1.5 block text-sm font-semibold">Link da tabela oficial de cores</label>
						<input id="editar-linha-cores-link" name="linha_cores_link" type="url" class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3" />
					</div>
				</div>
				<div>
					<label for="editar-pedido-data" class="mb-1.5 block text-sm font-semibold">Data do pedido</label>
					<input id="editar-pedido-data" name="data_pedido" type="date" required
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
					<input id="editar-pedido-entrega" name="data_entrega" type="hidden" />
					<input id="editar-pedido-prazo" name="dias_prazo" type="hidden" />
				</div>
				<div>
					<label for="editar-pedido-observacoes" class="mb-1.5 block text-sm font-semibold">Detalhes do pedido</label>
					<textarea id="editar-pedido-observacoes" name="observacoes" rows="4"
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20"></textarea>
				</div>
				<div class="flex flex-col-reverse justify-end gap-2 border-t border-[#e8d5c4] pt-5 sm:flex-row sm:gap-3">
					<button id="cancelar-modal-editar-pedido" type="button"
						class="rounded-lg border border-[#e8d5c4] px-4 py-2.5 text-sm font-semibold hover:bg-[#ffeae8]">Cancelar</button>
					<button type="submit"
						class="rounded-lg bg-[#5a262c] px-5 py-2.5 text-sm font-bold text-[#ffeae8] hover:bg-[#472025]">Salvar alterações</button>
				</div>
			</form>
		</div>
	</dialog>

	<div class="bg-white rounded-3xl border border-[#e8d5c4] shadow-sm overflow-hidden">
		<div class="overflow-x-auto overscroll-x-contain" role="region" aria-label="Tabela de pedidos" tabindex="0">
		<table class="min-w-[1000px] w-full text-left">
			<thead class="bg-[#ffeae8]/40 border-b border-[#e8d5c4]">
				<tr>
					<th class="p-5 font-bold text-[#5a262c]">Nº Pedido</th>
					<th class="p-5 font-bold text-[#5a262c]">Data</th>
					<th class="p-5 font-bold text-[#5a262c]">Cliente / Produto</th>
					<th class="p-5 font-bold text-[#5a262c]">Entrega</th>
					<th class="p-5 font-bold text-[#5a262c]">Pagamentos</th>
					<th class="p-5 font-bold text-[#5a262c]">Fluxo do pedido</th>
					<th class="p-5 font-bold text-[#5a262c]">Ações</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-[#e8d5c4]/50">
				for _, p := range pedidos {
				<tr id={ "pedido-" + fmt.Sprintf("%d", p.ID) } class="transition-colors hover:bg-[#ffeae8]/20">
					<td class="p-5 text-[#5a262c] font-bold">
						#{ fmt.Sprintf("%d", p.ID) }
					</td>
					<td class="whitespace-nowrap p-5 text-sm text-[#5a262c]/80">{ formatarDataPedido(p.DataPedido) }</td>
					<td class="p-5">
						<div class="text-[#5a262c]/90 font-bold">{ obterNomeCliente(p.ClienteID, clientes) }</div>
						<div class="text-[#5a262c]/70 text-sm">{ nomesItensPedido(p) }</div>
						if p.Brinde {
						<span class="mt-1 inline-flex rounded-full bg-[#7a8c5f]/10 px-2 py-0.5 text-[10px] font-bold text-[#56653f]">Brinde · R$ 0,00</span>
						if p.PedidoPrincipalID > 0 {
						<div class="mt-1 text-xs text-[#5a262c]/60">Relacionado ao pedido #{ fmt.Sprintf("%d", p.PedidoPrincipalID) }</div>
						}
						}
					</td>
					<td class="p-5 text-[#5a262c]/80 font-medium">{ formatarDataPedido(p.DataEntrega) }</td>
					<td class="whitespace-nowrap p-5">
						if p.Brinde {
						<span class="text-xs font-semibold text-[#56653f]">Sem cobrança</span>
						} else if len(p.Pagamentos) == 0 {
						<span class="text-xs text-[#5a262c]/50">—</span>
						} else {
						<div class="space-y-2">
							<p class="text-xs font-semibold text-[#5a262c]">
								{ fmt.Sprintf("%d/%d recebidos", pagamentosRecebidos(p.Pagamentos), len(p.Pagamentos)) }
							</p>
							<p class="text-xs text-[#5a262c]/70">{ FormatarReais(p.TotalAcordado) }</p>
							<button type="button" data-abrir-pagamentos data-modal-id={ "modal-pagamentos-" + fmt.Sprintf("%d", p.ID) }
								aria-label={ "Ver pagamentos do pedido " + fmt.Sprintf("%d", p.ID) }
								class="rounded-md border border-[#e8d5c4] px-3 py-1.5 text-xs font-semibold text-[#5a262c] hover:bg-[#ffeae8]">Ver pagamentos</button>
						</div>
						<dialog id={ "modal-pagamentos-" + fmt.Sprintf("%d", p.ID) }
							class="w-[min(42rem,calc(100%-2rem))] max-w-none rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-[#2b1719]/50">
							<div class="max-h-[85vh] overflow-y-auto bg-white p-4 sm:p-8">
								<div class="mb-5 flex items-start justify-between gap-4">
									<div>
										<p class="mb-1 text-sm font-semibold text-[#c17f6b]">Pedido #{ fmt.Sprintf("%d", p.ID) }</p>
										<h3 class="text-2xl font-serif font-bold text-[#5a262c]">Pagamentos</h3>
										<p class="mt-1 text-sm text-[#5a262c]/70">{ p.FormaPagamento } · Total { FormatarReais(p.TotalAcordado) }</p>
									</div>
									<button type="button" data-fechar-pagamentos aria-label="Fechar"
										class="rounded-full px-3 py-1 text-2xl text-[#5a262c]/60 hover:bg-[#ffeae8]">&times;</button>
								</div>
								<div class="space-y-3">
									for _, pagamento := range p.Pagamentos {
									<div class="rounded-xl border border-[#e8d5c4] p-4">
										<div class="flex items-center justify-between gap-3">
											<strong class="text-sm text-[#5a262c]">{ pagamento.Descricao }</strong>
											<strong class="text-sm text-[#5a262c]">{ FormatarReais(pagamento.Valor) }</strong>
										</div>
										if pagamento.Status == "Recebido" {
										<p class="mt-1 text-sm text-[#56653f]">Recebido em { formatarDataPedido(pagamento.DataRecebimento) }</p>
										} else {
										<p class="mt-1 text-sm text-[#5a262c]/70">Vence em { formatarDataPedido(pagamento.DataVencimento) } · Pendente</p>
										<form method="POST" action="/pedidos/pagamentos/receber" class="mt-3 flex flex-wrap items-end gap-3">
											<input type="hidden" name="pagamento_id" value={ fmt.Sprintf("%d", pagamento.ID) } />
											<label class="text-xs text-[#5a262c]/70">Data recebida
												<input name="data_recebimento" type="date" required value={ time.Now().Format("2006-01-02") }
													class="mt-1 block rounded border border-[#e8d5c4] px-2 py-1.5 text-sm" />
											</label>
											<label class="flex items-center gap-1.5 text-xs text-[#5a262c]/70">
												<input type="checkbox" name="confirmado" value="sim" required class="size-4 accent-[#5a262c]" />
												Confirmo que recebi
											</label>
											<button type="submit" class="rounded-md bg-[#7a8c5f] px-3 py-2 text-xs font-semibold text-white hover:bg-[#56653f]">Lançar no caixa</button>
										</form>
										<div class="mt-2 flex items-center gap-2">
											<button type="button" data-copiar-lembrete data-pagamento-id={ fmt.Sprintf("%d", pagamento.ID) }
												class="rounded-md border border-[#e8d5c4] px-3 py-1.5 text-xs font-semibold text-[#5a262c] hover:bg-[#ffeae8]">Copiar lembrete para WhatsApp</button>
											<span id={ "status-copia-lembrete-" + fmt.Sprintf("%d", pagamento.ID) } class="sr-only" aria-live="polite"></span>
										</div>
										<textarea id={ "mensagem-lembrete-" + fmt.Sprintf("%d", pagamento.ID) } readonly hidden>{ pagamento.MensagemLembrete }</textarea>
										}
									</div>
									}
								</div>
							</div>
						</dialog>
						}
					</td>
						<td class="p-5">
						<div class="space-y-2">
							@StatusLabel(p.Status)
							if len(modelos.ProximosStatusPedidoComBrinde(p.Status, p.Brinde)) > 0 {
							<form method="POST" action="/pedidos/status" class="flex flex-wrap items-center gap-2">
								<input type="hidden" name="pedido_id" value={ fmt.Sprintf("%d", p.ID) } />
								<select name="status" data-pedido-status
									class="max-w-48 rounded-lg border border-[#e8d5c4] bg-white px-2 py-1.5 text-xs focus:border-[#5a262c] focus:outline-none">
									for _, proximo := range modelos.ProximosStatusPedidoComBrinde(p.Status, p.Brinde) {
									<option value={ proximo }>{ proximo }</option>
									}
								</select>
								<button type="submit"
									class="rounded-md bg-[#5a262c] px-2.5 py-1.5 text-xs font-semibold text-[#ffeae8] hover:bg-[#472025]">Avançar</button>
							</form>
							if p.Status == modelos.StatusAguardandoSinal {
							<dialog id={ "modal-sinal-" + fmt.Sprintf("%d", p.ID) }
								class="w-[min(38rem,calc(100%-2rem))] max-w-none rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-[#2b1719]/50">
								<div class="max-h-[85vh] overflow-y-auto bg-white p-4 sm:p-8">
									<div class="mb-5 flex items-start justify-between gap-4">
										<div>
											<p class="mb-1 text-sm font-semibold text-[#c17f6b]">Pedido #{ fmt.Sprintf("%d", p.ID) }</p>
											<h3 class="text-2xl font-serif font-bold text-[#5a262c]">Confirmar sinal recebido</h3>
											<p class="mt-1 text-sm text-[#5a262c]/70">Escolha as condições de pagamento. O sinal só será lançado no caixa após confirmar o recebimento.</p>
										</div>
										<button type="button" data-fechar-modal-sinal aria-label="Fechar"
											class="rounded-full px-3 py-1 text-2xl text-[#5a262c]/60 hover:bg-[#ffeae8]">&times;</button>
									</div>
									<form method="POST" action="/pedidos/status" class="space-y-4">
										<input type="hidden" name="pedido_id" value={ fmt.Sprintf("%d", p.ID) } />
										<input type="hidden" name="status" value={ modelos.StatusSinalRecebido } />
										<label class="block text-sm font-semibold text-[#5a262c]">Forma de pagamento aceita
											<select name="forma_pagamento" data-forma-pagamento required class="mt-1 w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5">
												if p.DescontoPixAvista {
												<option value="Pix à vista">Pix à vista (10% de desconto)</option>
												} else {
												<option value="Pix à vista">Pix à vista (sem desconto)</option>
												}
												if p.PixParcelado {
												<option value="Pix parcelado">Pix parcelado</option>
												}
												<option value="Cartão de crédito">Cartão de crédito</option>
											</select>
										</label>
										<div data-detalhes-parcelamento class="space-y-3">
											<label class="block text-sm font-semibold text-[#5a262c]">Parcelas após o sinal
												<select name="numero_parcelas" class="mt-1 w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5">
													<option value="1">1 parcela</option>
													<option value="2" selected>2 parcelas</option>
													<option value="3">3 parcelas</option>
												</select>
											</label>
											<label class="block text-sm font-semibold text-[#5a262c]">Vencimento da primeira parcela
												<input name="primeira_data" type="date" required value={ time.Now().AddDate(0, 1, 0).Format("2006-01-02") }
													class="mt-1 w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5" />
											</label>
										</div>
										<div class="rounded-lg bg-[#fcf9f8] p-3 text-sm text-[#5a262c]/70">
											<p>Para Pix parcelado ou cartão, o sinal é 30% e as parcelas vencem mensalmente. No Pix à vista, será registrado o pagamento total de uma vez.</p>
										</div>
										<label class="block text-sm font-semibold text-[#5a262c]">Data em que recebeu o sinal
											<input name="data_recebimento" type="date" required value={ time.Now().Format("2006-01-02") }
												class="mt-1 w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5" />
										</label>
										<label class="flex items-start gap-2 text-sm text-[#5a262c]">
											<input type="checkbox" name="confirmado" value="sim" required class="mt-0.5 size-4 accent-[#5a262c]" />
											<span>Confirmo que recebi o sinal e autorizo o lançamento no caixa.</span>
										</label>
										<div class="flex flex-col-reverse justify-end gap-2 border-t border-[#e8d5c4] pt-4 sm:flex-row sm:gap-3">
											<button type="button" data-fechar-modal-sinal class="rounded-lg border border-[#e8d5c4] px-4 py-2.5 text-sm font-semibold hover:bg-[#ffeae8]">Voltar</button>
											<button type="submit" class="rounded-lg bg-[#7a8c5f] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#56653f]">Confirmar e avançar</button>
										</div>
									</form>
								</div>
							</dialog>
							}
							}
						</div>
					</td>
					<td class="p-5">
						<details data-menu-acoes-pedido class="relative">
							<summary aria-label={ "Ações do pedido " + fmt.Sprintf("%d", p.ID) }
								class="grid size-9 cursor-pointer list-none place-items-center rounded-lg border border-[#e8d5c4] bg-white text-lg font-bold tracking-widest hover:bg-[#ffeae8] [&::-webkit-details-marker]:hidden">...</summary>
							<div popover="manual" data-conteudo-menu-acoes-pedido class="fixed m-0 max-h-[calc(100vh-1rem)] min-w-44 overflow-y-auto rounded-lg border border-[#e8d5c4] bg-white py-1 shadow-lg">
								<button type="button" data-abrir-detalhes data-modal-id={ "modal-detalhes-" + fmt.Sprintf("%d", p.ID) }
									class="block w-full px-4 py-2 text-left text-sm hover:bg-[#ffeae8]">Ver detalhes</button>
								<button type="button" data-editar-pedido data-id={ fmt.Sprintf("%d", p.ID) }
									data-itens={ itensPedidoJSON(p.Itens) }
									data-data-pedido={ p.DataPedido } data-data-entrega={ p.DataEntrega }
									data-observacoes={ p.Observacoes } data-cliente-id={ fmt.Sprintf("%d", p.ClienteID) }
									data-produto-id={ fmt.Sprintf("%d", p.ProdutoID) } data-dias-prazo={ fmt.Sprintf("%d", p.DiasPrazo) }
									data-pedido-brinde={ fmt.Sprintf("%t", p.Brinde) }
									data-pedido-principal-id={ fmt.Sprintf("%d", p.PedidoPrincipalID) }
									data-desconto-cartao={ fmt.Sprintf("%g", p.DescontoCartao) }
									data-desconto-pix={ fmt.Sprintf("%g", p.DescontoPix) }
									data-desconto-pix-avista={ fmt.Sprintf("%t", p.DescontoPixAvista) }
									data-pix-parcelado={ fmt.Sprintf("%t", p.PixParcelado) }
									data-incluir-brinde={ fmt.Sprintf("%t", p.IncluirBrinde) }
									data-linha-cores-nome={ p.LinhaCoresNome } data-linha-cores-link={ p.LinhaCoresLink }
									data-pagamentos={ fmt.Sprintf("%d", len(p.Pagamentos)) }
									class="block w-full px-4 py-2 text-left text-sm hover:bg-[#ffeae8]">Editar pedido</button>
								<button type="button" data-copiar-orcamento data-pedido-id={ fmt.Sprintf("%d", p.ID) }
									class="block w-full px-4 py-2 text-left text-sm hover:bg-[#ffeae8]">Copiar orçamento</button>
								if !p.Brinde {
								<a href={ "/pedidos/orcamento?pedido_id=" + fmt.Sprintf("%d", p.ID) } target="_blank" rel="noreferrer"
									class="block w-full px-4 py-2 text-left text-sm hover:bg-[#ffeae8]">Imprimir / salvar PDF</a>
								}
							</div>
						</details>
						<dialog id={ "modal-detalhes-" + fmt.Sprintf("%d", p.ID) }
							class="w-[min(48rem,calc(100%-2rem))] max-w-none rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-[#2b1719]/50">
							<div class="max-h-[90vh] overflow-y-auto bg-white p-4 sm:p-8">
								<div class="mb-6 flex items-start justify-between gap-4">
									<div>
										<p class="mb-1 text-sm font-semibold text-[#c17f6b]">Pedido #{ fmt.Sprintf("%d", p.ID) }</p>
										<h3 class="text-2xl font-serif font-bold text-[#5a262c]">Detalhes do pedido</h3>
										<p class="mt-1 text-sm text-[#5a262c]/70">{ obterNomeCliente(p.ClienteID, clientes) } · { nomesItensPedido(p) }</p>
									</div>
									<button type="button" data-fechar-detalhes aria-label="Fechar"
										class="rounded-full px-3 py-1 text-2xl text-[#5a262c]/60 hover:bg-[#ffeae8]">&times;</button>
								</div>
								<section class="grid gap-3 rounded-xl border border-[#e8d5c4] bg-[#fcf9f8] p-4 sm:grid-cols-2">
									<div>
										<h4 class="mb-2 font-bold text-[#5a262c]">Pedido</h4>
										<dl class="space-y-1.5 text-sm">
											<div><dt class="inline font-semibold">Status: </dt><dd class="inline">{ p.Status }</dd></div>
											<div><dt class="inline font-semibold">Data: </dt><dd class="inline">{ formatarDataPedido(p.DataPedido) }</dd></div>
											<div><dt class="inline font-semibold">Entrega prevista: </dt><dd class="inline">{ formatarDataPedido(p.DataEntrega) }</dd></div>
											<div><dt class="inline font-semibold">Prazo: </dt><dd class="inline">{ fmt.Sprintf("%d dias úteis", p.DiasPrazo) }</dd></div>
											<div><dt class="inline font-semibold">Tipo: </dt><dd class="inline">{ tipoPedido(p.Brinde) }</dd></div>
											if p.PedidoPrincipalID > 0 {
											<div><dt class="inline font-semibold">Pedido principal: </dt><dd class="inline">#{ fmt.Sprintf("%d", p.PedidoPrincipalID) }</dd></div>
											}
										</dl>
									</div>
									<div>
										<h4 class="mb-2 font-bold text-[#5a262c]">Cliente</h4>
										<dl class="space-y-1.5 text-sm">
											<div><dt class="inline font-semibold">Nome: </dt><dd class="inline">{ obterNomeCliente(p.ClienteID, clientes) }</dd></div>
											<div><dt class="inline font-semibold">WhatsApp: </dt><dd class="inline">{ valorOuTraco(obterClientePedido(p.ClienteID, clientes).Whatsapp) }</dd></div>
											<div><dt class="inline font-semibold">Cidade/UF: </dt><dd class="inline">{ localizacaoCliente(obterClientePedido(p.ClienteID, clientes)) }</dd></div>
										</dl>
									</div>
									<div>
										<h4 class="mb-2 font-bold text-[#5a262c]">Produto e valores</h4>
										<dl class="space-y-1.5 text-sm">
										<div class="sm:col-span-2">
											<dt class="mb-1 font-semibold">Produtos:</dt>
											<dd><ul class="space-y-1">
												for _, item := range p.Itens {
												<li>{ fmt.Sprintf("%dx %s · %s cada", item.Quantidade, item.NomeProduto, FormatarReais(item.PrecoUnitario)) }</li>
												}
											</ul></dd>
										</div>
											<div><dt class="inline font-semibold">Preço base do pedido: </dt><dd class="inline">{ FormatarReais(p.PrecoBase) }</dd></div>
											<div><dt class="inline font-semibold">Forma de pagamento: </dt><dd class="inline">{ valorOuTraco(p.FormaPagamento) }</dd></div>
											<div><dt class="inline font-semibold">Total acordado: </dt><dd class="inline">{ FormatarReais(p.TotalAcordado) }</dd></div>
											<div><dt class="inline font-semibold">Desconto no cartão: </dt><dd class="inline">{ percentualOuTraco(p.DescontoCartao) }</dd></div>
											<div><dt class="inline font-semibold">Desconto no Pix parcelado: </dt><dd class="inline">{ percentualOuTraco(p.DescontoPix) }</dd></div>
											<div><dt class="inline font-semibold">Desconto no Pix à vista: </dt><dd class="inline">{ opcionalSimNao(p.DescontoPixAvista) }</dd></div>
											<div><dt class="inline font-semibold">Pix parcelado oferecido: </dt><dd class="inline">{ simNao(p.PixParcelado) }</dd></div>
										</dl>
									</div>
									<div>
										<h4 class="mb-2 font-bold text-[#5a262c]">Personalização</h4>
										<dl class="space-y-1.5 text-sm">
											<div><dt class="inline font-semibold">Linha de fios: </dt><dd class="inline">{ valorOuTraco(p.LinhaCoresNome) }</dd></div>
											<div><dt class="inline font-semibold">Tabela de cores: </dt><dd class="inline">
												if p.LinhaCoresLink != "" {
												<a href={ p.LinhaCoresLink } target="_blank" rel="noreferrer" class="break-all text-[#8b4c41] underline">{ p.LinhaCoresLink }</a>
												} else {
												{ "—" }
												}
											</dd></div>
											<div><dt class="inline font-semibold">Inclui brinde: </dt><dd class="inline">{ simNao(p.IncluirBrinde) }</dd></div>
										</dl>
									</div>
								</section>
								<section class="space-y-2 rounded-xl border border-[#e8d5c4] bg-[#fcf9f8] p-4">
									<h4 class="font-bold text-[#5a262c]">Observações</h4>
									if strings.TrimSpace(p.Observacoes) == "" {
									<p class="text-sm text-[#5a262c]/50">Nenhuma observação registrada.</p>
									} else {
									<p class="whitespace-pre-wrap text-sm text-[#5a262c]/80">{ p.Observacoes }</p>
									}
								</section>
								<section class="mt-5 space-y-2 rounded-xl border border-[#e8d5c4] p-4">
									<h4 class="font-bold text-[#5a262c]">Pagamentos</h4>
									if len(p.Pagamentos) == 0 {
									<p class="text-sm text-[#5a262c]/50">Nenhum pagamento registrado.</p>
									} else {
									<div class="divide-y divide-[#e8d5c4]">
										for _, pagamento := range p.Pagamentos {
										<div class="flex flex-wrap items-start justify-between gap-2 py-2 text-sm">
											<div>
												<p class="font-semibold text-[#5a262c]">{ pagamento.Descricao } · { FormatarReais(pagamento.Valor) }</p>
												if pagamento.Status == "Recebido" {
												<p class="text-[#56653f]">Recebido em { formatarDataPedido(pagamento.DataRecebimento) }</p>
												} else {
												<p class="text-[#5a262c]/70">Pendente · vence em { formatarDataPedido(pagamento.DataVencimento) }</p>
												}
											</div>
											<span class="text-xs font-semibold">{ pagamento.Status }</span>
										</div>
										}
									</div>
									}
								</section>
								<section class="mt-5 space-y-3">
									<div>
										<h4 class="font-bold text-[#5a262c]">Etiquetas</h4>
										<p class="text-xs text-[#5a262c]/60">Adicione várias etiquetas curtas para organizar este pedido.</p>
									</div>
									if len(p.Etiquetas) > 0 {
									<div class="flex flex-wrap gap-2">
										for _, etiqueta := range p.Etiquetas {
										<div style={ "background-color: " + corEtiquetaPedido(etiqueta.Cor) + "; color: #5a262c" }
											class="inline-flex items-center gap-1 rounded-full px-3 py-1 text-sm font-semibold">
											<span>{ etiqueta.Texto }</span>
											<form method="POST" action="/pedidos/etiquetas/excluir">
												<input type="hidden" name="pedido_id" value={ fmt.Sprintf("%d", p.ID) } />
												<input type="hidden" name="etiqueta_id" value={ fmt.Sprintf("%d", etiqueta.ID) } />
												<button type="submit" aria-label={ "Remover etiqueta " + etiqueta.Texto }
													class="rounded-full px-1 leading-5 hover:bg-black/10">&times;</button>
											</form>
										</div>
										}
									</div>
									} else {
									<p class="text-sm text-[#5a262c]/50">Nenhuma etiqueta adicionada.</p>
									}
									<form method="POST" action="/pedidos/etiquetas/adicionar" class="grid gap-3 rounded-xl border border-dashed border-[#e8d5c4] p-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-end">
										<input type="hidden" name="pedido_id" value={ fmt.Sprintf("%d", p.ID) } />
										<label class="text-sm font-semibold text-[#5a262c]">Texto da etiqueta
											<input name="texto" type="text" maxlength="100" required placeholder="Ex.: presente, urgente..."
												class="mt-1 w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5 font-normal" />
										</label>
										<label class="text-sm font-semibold text-[#5a262c]">Cor em hexadecimal
											<input name="cor" type="text" required minlength="7" maxlength="7" pattern="#[0-9A-Fa-f]{6}"
												placeholder="#D98C9A" title="Informe a cor no formato #RRGGBB"
												class="mt-1 block w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5 font-mono font-normal" />
										</label>
										<button type="submit" class="rounded-lg bg-[#5a262c] px-4 py-2.5 text-sm font-bold text-[#ffeae8] hover:bg-[#472025]">Adicionar</button>
									</form>
								</section>
								if p.MensagemOrcamento != "" {
								<details class="mt-5 rounded-xl border border-[#e8d5c4] p-4">
									<summary class="cursor-pointer text-sm font-bold text-[#5a262c]">Mensagem completa do orçamento</summary>
									<p class="mt-3 whitespace-pre-wrap text-sm text-[#5a262c]/80">{ p.MensagemOrcamento }</p>
								</details>
								}
							</div>
						</dialog>
						<textarea id={ "mensagem-orcamento-" + fmt.Sprintf("%d", p.ID) } readonly
							hidden>{ p.MensagemOrcamento }</textarea>
						<span id={ "status-copia-orcamento-" + fmt.Sprintf("%d", p.ID) } class="sr-only"
							aria-live="polite"></span>
					</td>
				</tr>
				}
			</tbody>
		</table>
		</div>
		if len(pedidos) == 0 {
		<div class="p-10 text-center text-[#5a262c]/50 font-medium">Você ainda não tem nenhum pedido cadastrado.</div>
		}
	</div>
	<div id="notificacao-copia-orcamento" role="status" aria-live="polite" hidden
		class="fixed bottom-4 right-4 z-50 max-w-sm rounded-xl bg-[#5a262c] px-5 py-3 text-sm font-semibold text-white shadow-xl transition-opacity">
		Orçamento copiado.
	</div>
	<script src="/static/js/pedidos.js" defer></script>
</div>
}

func pagamentosRecebidos(pagamentos []modelos.Pagamento) int {
	recebidos := 0
	for _, pagamento := range pagamentos {
		if pagamento.Status == "Recebido" {
			recebidos++
		}
	}
	return recebidos
}

func formatarDataPedido(data string) string {
dataConvertida, err := time.Parse("2006-01-02", data)
if err != nil {
return data
}
return dataConvertida.Format("02-01-2006")
}

func tipoPedido(brinde bool) string {
	if brinde {
		return "Brinde"
	}
	return "Encomenda"
}

func valorOuTraco(valor string) string {
	if strings.TrimSpace(valor) == "" {
		return "—"
	}
	return valor
}

func localizacaoCliente(cliente modelos.Cliente) string {
	cidade := strings.TrimSpace(cliente.Cidade)
	estado := strings.TrimSpace(cliente.Estado)
	if cidade == "" && estado == "" {
		return "—"
	}
	if cidade == "" {
		return estado
	}
	if estado == "" {
		return cidade
	}
	return cidade + "/" + estado
}

func percentualOuTraco(valor float64) string {
	if valor <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.2g%%", valor)
}

func simNao(valor bool) string {
	if valor {
		return "Sim"
	}
	return "Não"
}

func opcionalSimNao(valor bool) string {
	if valor {
		return "10%"
	}
	return "Não"
}

func corEtiquetaPedido(cor string) string {
	if len(cor) != 7 || cor[0] != '#' {
		return "#ffeae8"
	}
	if _, err := strconv.ParseUint(cor[1:], 16, 24); err != nil {
		return "#ffeae8"
	}
	return cor
}

templ StatusLabel(status string) {
if status == modelos.StatusOrcamento {
<span class="inline-flex items-center rounded-full bg-[#e8d5c4]/50 px-3 py-1 text-[11px] font-bold text-[#5a262c]">{
	status }</span>
} else if status == modelos.StatusAguardandoSinal || status == modelos.StatusAguardandoPagamento {
<span class="inline-flex items-center rounded-full bg-[#f0dcb0] px-3 py-1 text-[11px] font-bold text-[#5a262c]">{ status
	}</span>
} else if status == modelos.StatusEntregue {
<span class="inline-flex items-center rounded-full bg-[#7a8c5f]/15 px-3 py-1 text-[11px] font-bold text-[#56653f]">{
	status }</span>
} else if status == modelos.StatusEmProducao {
<span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-[11px] font-bold text-blue-700">{ status
	}</span>
} else if status == modelos.StatusSinalRecebido || status == modelos.StatusPago {
<span class="inline-flex items-center rounded-full bg-[#ffeae8] px-3 py-1 text-[11px] font-bold text-[#5a262c]">{ status
	}</span>
} else if status == modelos.StatusCancelado {
<span class="inline-flex items-center rounded-full bg-[#c17f6b]/20 px-3 py-1 text-[11px] font-bold text-[#7d4438]">{
	status }</span>
} else {
<span class="inline-flex items-center rounded-full bg-[#e8d5c4]/30 px-3 py-1 text-[11px] font-bold text-[#5a262c]">{
	status }</span>
}
}

// funcoes auxiliares para mostrar os nomes verdadeiros na tabela (no lugar do id)
func obterNomeCliente(id int, clientes []modelos.Cliente) string {
for _, c := range clientes {
if c.ID == id {
return c.Nome
}
}
return "Desconhecido"
}

func obterNomeProduto(id int, produtos []modelos.Produto) string {
for _, p := range produtos {
if p.ID == id {
return p.NomePeca
}
}
return "Desconhecido"
}

func nomesItensPedido(pedido modelos.Pedido) string {
	if len(pedido.Itens) == 0 {
		return "Produto"
	}
	nomes := make([]string, 0, len(pedido.Itens))
	for _, item := range pedido.Itens {
		if item.Quantidade > 1 {
			nomes = append(nomes, fmt.Sprintf("%dx %s", item.Quantidade, item.NomeProduto))
		} else {
			nomes = append(nomes, item.NomeProduto)
		}
	}
	return strings.Join(nomes, ", ")
}

func itensPedidoJSON(itens []modelos.ItemPedido) string {
	dados, err := json.Marshal(itens)
	if err != nil {
		return "[]"
	}
	return string(dados)
}

func obterClientePedido(id int, clientes []modelos.Cliente) modelos.Cliente {
	for _, cliente := range clientes {
		if cliente.ID == id {
			return cliente
		}
	}
	return modelos.Cliente{Nome: "Desconhecido"}
}

func obterProdutoPedido(id int, produtos []modelos.Produto) modelos.Produto {
	for _, produto := range produtos {
		if produto.ID == id {
			return produto
		}
	}
	return modelos.Produto{NomePeca: "Desconhecido"}
}