package views

templ Login(mensagem string) {
<!DOCTYPE html>
<html lang="pt-BR">
@BaseHead("Acesso administrativo")

<body class="min-h-screen bg-[#ffeae8] text-[#5a262c] font-sans flex items-center justify-center p-5">
	<main class="w-full max-w-md bg-white border border-[#e8d5c4] rounded-2xl p-8 shadow-sm">
		<img src="/static/logo.png" alt="Falk Crochê" class="mb-4 h-24 w-40 object-contain object-left" />
		<h1 class="text-3xl font-bold mb-2">Área administrativa</h1>
		<p class="text-[#5a262c]/70 mb-7">Entre para gerenciar o ateliê.</p>
		if mensagem != "" {
		<p role="alert" class="mb-5 rounded-lg bg-[#c17f6b]/10 border border-[#c17f6b]/30 px-4 py-3 text-sm">{ mensagem
			}</p>
		}
		<form method="POST" action="/admin/login" class="space-y-4">
			<div>
				<label for="senha" class="block text-sm font-medium mb-1">Senha</label>
				<input id="senha" name="senha" type="password" autocomplete="current-password" required
					class="w-full rounded-lg border border-[#e8d5c4] px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#7a8c5f]" />
			</div>
			<button type="submit"
				class="w-full rounded-lg bg-[#5a262c] text-white py-2.5 font-semibold hover:bg-[#472025] transition-colors">Entrar</button>
		</form>
		<a href="/" class="inline-block mt-6 text-sm text-[#7a8c5f] hover:underline">Voltar ao catálogo público</a>
	</main>
</body>

</html>
}