package views

import (
"net/url"
"strings"

"falkcroche/modelos"
)

templ VitrinePublica(produtos []modelos.Produto, whatsapp string) {
if len(produtos) == 0 {
<section class="mx-auto max-w-lg py-10 text-center sm:py-14">
    <p class="mb-2 text-xs font-semibold uppercase text-[#7a8c5f]">
        Feito à mão, com carinho
    </p>

    <h2 class="mb-3 font-serif text-2xl font-bold sm:text-3xl">
        Novas peças estão tomando forma.
    </h2>

    <p class="mb-6 text-sm leading-relaxed text-[#5a262c]/70 sm:text-base">
        Nosso catálogo está sendo preparado. Enquanto isso, fale com a gente
        sobre uma peça personalizada.
    </p>

    if whatsapp != "" {
    <a href={ linkWhatsAppContato(whatsapp) } target="_blank" rel="noreferrer"
        class="inline-flex items-center justify-center rounded-lg bg-[#5a262c] px-4 py-2.5 text-sm font-semibold text-[#ffeae8] transition-colors hover:bg-[#472025]">
        Falar pelo WhatsApp
    </a>
    }
</section>
} else {
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
    for _, p := range produtos {
    <article
        class="relative rounded-lg border border-[#e8d5c4]/70 bg-white p-3 shadow-sm transition-shadow hover:shadow-md">
        if p.ProntaEntrega {
        <span
            class="absolute right-5 top-5 z-10 rounded-full bg-[#7a8c5f] px-2.5 py-1 text-[11px] font-bold text-white">
            Pronta entrega
        </span>
        }

        <div class="relative mb-3 aspect-square overflow-hidden rounded-md bg-[#fcf9f8]">
            if p.FotoURL != "" {
            <img src={ p.FotoURL } alt={ p.NomePeca }
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
            } else {
            <div class="flex h-full w-full items-center justify-center text-sm text-[#5a262c]/40">
                Sem imagem
            </div>
            }
        </div>

        <div class="px-1 pb-1 text-center">
            <h3 class="mb-1 font-serif text-lg font-semibold text-[#5a262c]">
                { p.NomePeca }
            </h3>

            <p class="mb-3 text-base font-bold text-[#c17f6b]">
                { FormatarReais(p.Preco) }
            </p>

            if whatsapp != "" {
            <a href={ linkWhatsApp(whatsapp, p.NomePeca) } target="_blank" rel="noreferrer"
                class="inline-flex w-full items-center justify-center rounded-md bg-[#5a262c] py-2.5 text-sm font-bold text-[#ffeae8] transition-colors hover:bg-[#472025]">
                Tenho interesse
            </a>
            }
        </div>
    </article>
    }
</div>

if whatsapp != "" {
<section
    class="mt-7 flex flex-col items-start justify-between gap-4 border-t border-[#c17f6b]/30 pt-5 sm:flex-row sm:items-center">
    <div>
        <h2 class="font-serif text-lg font-semibold text-[#5a262c]">
            Não encontrou o que queria?
        </h2>

        <p class="mt-1 text-sm text-[#5a262c]/70">
            Chame a gente para conversar sobre uma peça personalizada.
        </p>
    </div>

    <a href={ linkWhatsAppContato(whatsapp) } target="_blank" rel="noreferrer"
        class="inline-flex shrink-0 items-center justify-center rounded-lg border border-[#25D366] bg-[#25D366] px-4 py-2.5 text-sm font-semibold text-[#111B21] transition-colors hover:border-[#1ebe5d] hover:bg-[#1ebe5d]">
        Conversar no WhatsApp
    </a>
</section>
}
}
}

func linkWhatsApp(numero string, nomeProduto string) string {
return linkWhatsAppMensagem(
numero,
"Oi! Tenho interesse na peça "+nomeProduto+".",
)
}

func linkWhatsAppContato(numero string) string {
return linkWhatsAppMensagem(
numero,
"Oi! Não encontrei o que queria na vitrine e gostaria de consultar outras peças.",
)
}

func linkWhatsAppMensagem(numero string, mensagem string) string {
var digitos strings.Builder

for _, caractere := range numero {
if caractere >= '0' && caractere <= '9' {
digitos.WriteRune(caractere)
}
}
if digitos.Len() == 0 {
return ""
}
return "https://wa.me/" + digitos.String() + "?text=" + url.QueryEscape(mensagem)
}