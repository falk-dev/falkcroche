package views

templ BaseHead(title string, staticPrefix string) {

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{ title } - Falk Crochê</title>
	<link rel="icon" href={ staticPrefix + "/favicon.ico" } sizes="any" />
	<link rel="icon" type="image/png" sizes="16x16" href={ staticPrefix + "/favicon-16x16.png" } />
	<link rel="icon" type="image/png" sizes="32x32" href={ staticPrefix + "/favicon-32x32.png" } />
	<link rel="apple-touch-icon" sizes="180x180" href={ staticPrefix + "/apple-touch-icon.png" } />
	<link rel="manifest" href={ staticPrefix + "/site.webmanifest" } />
	<meta name="theme-color" content="#5a262c" />
	<script src="https://cdn.tailwindcss.com"></script>
	<link
		href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700;800&display=swap"
		rel="stylesheet" />
	<style>
		body.font-sans {
			font-family: 'DM Sans', sans-serif;
		}

		body .font-serif {
			font-family: 'Fraunces', serif;
		}
	</style>
</head>
}

// AdminLayout eh o layout privado de gestao
templ AdminLayout(title string, content templ.Component) {
<!DOCTYPE html>
<html lang="pt-BR">
@BaseHead(title, "/static")
<!-- fundo levemente escurecido para destacar o painel central -->

<body
	class="flex min-h-screen items-start justify-center bg-[#e8d5c4]/40 p-2 font-sans text-[#5a262c] antialiased sm:p-4 lg:items-center lg:p-8">

	<!-- container principal (canto arredondado grande) -->
	<div
		class="bg-[#fdfbf9] rounded-2xl sm:rounded-[2rem] w-full max-w-[1400px] min-h-[calc(100vh-1rem)] sm:min-h-[calc(100vh-2rem)] lg:min-h-[calc(100vh-4rem)] shadow-xl overflow-hidden flex flex-col border border-white">

		<!-- menu horizontal -->
		<header class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 px-3 py-3 sm:px-6 sm:py-5 lg:flex-nowrap lg:gap-4 lg:px-8">

			<!-- logo -->
			<div class="flex items-center gap-3">
				<img src="/static/logo.png" alt="Falk Crochê" class="h-12 w-24 object-contain sm:h-16 sm:w-28" />
			</div>

			<nav class="hidden lg:flex items-center gap-2 bg-[#ffeae8]/60 p-1.5 rounded-full border border-[#ffeae8]">
				@AdminNavLink("Geral", "/dashboard", title == "Visão Geral")
				@AdminNavLink("Pedidos", "/pedidos", title == "Gestão de Pedidos")
				@AdminNavLink("Produtos", "/produtos", title == "Catálogo de Produtos")
				@AdminNavLink("Categorias", "/categorias", title == "Categorias")
				@AdminNavLink("Clientes", "/clientes", title == "Meus Clientes")
				@AdminNavLink("Financeiro", "/financeiro", title == "Gestão Financeira")
			</nav>

			<div class="flex items-center gap-2 sm:gap-4">
				<button id="abrir-notificacoes" type="button" aria-label="Abrir lembretes de vencimento"
					class="relative grid size-9 shrink-0 place-items-center rounded-full border border-[#e8d5c4] bg-white text-[#5a262c] transition-colors hover:bg-[#ffeae8] sm:size-10">
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9m-8 12a2 2 0 0 0 4 0" />
					</svg>
					<span id="contador-notificacoes" hidden
						class="absolute -right-1 -top-1 min-w-5 rounded-full bg-[#c17f6b] px-1 text-center text-[10px] font-bold leading-5 text-white"></span>
				</button>
				<a href="/" target="_blank" rel="noreferrer"
					class="hidden md:flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold bg-white text-[#c17f6b] border border-[#e8d5c4] hover:bg-[#ffeae8] transition-colors shadow-sm">
					Vitrine Pública
				</a>
				<div
					class="hidden h-10 w-10 shrink-0 rounded-full bg-[#5a262c] text-lg font-bold text-[#ffeae8] shadow-sm sm:flex sm:items-center sm:justify-center">
					F</div>
				<form method="POST" action="/admin/sair">
					<button type="submit" class="text-sm font-medium text-[#5a262c] hover:underline">Sair</button>
				</form>
			</div>
			<details class="order-last basis-full lg:hidden">
				<summary class="flex cursor-pointer list-none items-center justify-between rounded-lg border border-[#e8d5c4] bg-[#ffeae8]/60 px-4 py-2.5 text-sm font-bold text-[#5a262c]">
					Menu
					<svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
						<path fill-rule="evenodd" d="M5.22 7.22a.75.75 0 0 1 1.06 0L10 10.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
					</svg>
				</summary>
				<nav aria-label="Menu principal" class="mt-2 grid grid-cols-2 gap-2 rounded-xl border border-[#e8d5c4] bg-white p-2 sm:grid-cols-3">
					@AdminNavLink("Geral", "/dashboard", title == "Visão Geral")
					@AdminNavLink("Pedidos", "/pedidos", title == "Gestão de Pedidos")
					@AdminNavLink("Produtos", "/produtos", title == "Catálogo de Produtos")
					@AdminNavLink("Categorias", "/categorias", title == "Categorias")
					@AdminNavLink("Clientes", "/clientes", title == "Meus Clientes")
					@AdminNavLink("Financeiro", "/financeiro", title == "Gestão Financeira")
					<a href="/" target="_blank" rel="noreferrer"
						class="rounded-full px-3 py-2 text-center text-xs font-bold text-[#5a262c] hover:bg-[#ffeae8]">Vitrine</a>
				</nav>
			</details>
		</header>

		<dialog id="modal-notificacoes"
			class="w-[min(34rem,calc(100%-2rem))] max-w-none rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-[#2b1719]/50">
			<div class="max-h-[80vh] overflow-y-auto bg-white p-4 sm:p-8">
				<div class="mb-5 flex items-start justify-between gap-4">
					<div>
						<p class="mb-1 text-sm font-semibold text-[#c17f6b]">Ateliê</p>
						<h3 class="text-2xl font-serif font-bold text-[#5a262c]">Lembretes de pagamento</h3>
					</div>
					<button id="fechar-modal-notificacoes" type="button" aria-label="Fechar"
						class="rounded-full px-3 py-1 text-2xl text-[#5a262c]/60 hover:bg-[#ffeae8]">&times;</button>
				</div>
				<p id="mensagem-notificacoes" class="mb-4 text-sm text-[#5a262c]/60" aria-live="polite">Carregando lembretes...</p>
				<div id="lista-notificacoes" class="space-y-3"></div>
			</div>
		</dialog>

		<main class="min-w-0 flex-1 overflow-y-auto p-3 sm:p-6 lg:p-12">
			<div class="mx-auto min-w-0 max-w-7xl">
				if title != "Visão Geral" {
				<div class="flex items-center justify-between mb-8">
					<h2 class="text-2xl font-serif font-bold text-[#5a262c] sm:text-3xl">{ title }</h2>
				</div>
				}
				@content
			</div>
		</main>
	</div>
	<script>
		document.addEventListener("click", (evento) => {
			if (evento.target instanceof HTMLDialogElement && evento.target.open) evento.target.close();
		});
	</script>
	<script src="/static/js/notificacoes.js" defer></script>
</body>

</html>
}

templ AdminNavLink(label string, href string, ativa bool) {
if ativa {
<a href={ href } aria-current="page"
	class="rounded-lg px-3 py-2 text-center text-xs font-bold bg-[#5a262c] text-[#ffeae8] shadow-sm transition-colors sm:px-4 sm:text-sm lg:rounded-full lg:px-5">{ label
	}</a>
} else {
<a href={ href }
	class="rounded-lg px-3 py-2 text-center text-xs font-bold text-[#5a262c] hover:bg-white hover:shadow-sm transition-all duration-300 sm:px-4 sm:text-sm lg:rounded-full lg:px-5">{
	label }</a>
}
}

// PublicLayout eh o layout da página publica para os clientes
templ PublicLayout(title string, content templ.Component, logoURL string, staticPrefix string) {
<!DOCTYPE html>
<html lang="pt-BR">
@BaseHead(title, staticPrefix)
<script type="text/javascript">
	(function(c,l,a,r,i,t,y){
		c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
		t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
		y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
	})(window, document, "clarity", "script", "z085lt3fid");
</script>

	<body class="flex min-h-screen items-start justify-center bg-[#e8d5c4]/40 p-2 font-sans text-[#5a262c] antialiased sm:p-4 lg:items-center lg:p-8">
	<div class="flex min-h-[calc(100vh-1rem)] w-full max-w-[1400px] flex-col overflow-hidden rounded-2xl border border-white bg-[#fdfbf9] shadow-xl sm:min-h-[calc(100vh-2rem)] sm:rounded-[2rem] lg:min-h-[calc(100vh-4rem)]">
	<header class="px-4 pb-3 pt-6 text-center sm:pt-8">
		<img src={ logoURL } alt="Falk Crochê" class="mx-auto mb-2 h-24 w-40 object-contain sm:h-28 sm:w-48" />
		<p class="text-[#c17f6b] text-sm font-medium sm:text-base">Feito à mão, com o coração.</p>
	</header>
	<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-5 sm:px-6 sm:py-6">
		@content
	</main>
	<footer class="py-6 text-center text-xs font-medium text-[#5a262c]/60 sm:text-sm">
		&copy; 2026 Falk Crochê. Todos os direitos reservados.
	</footer>
	</div>
	<script src="/static/js/vitrine.js" defer></script>
</body>

</html>
}