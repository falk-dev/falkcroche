package views

templ BaseHead(title string) {

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{ title } - Falk Crochê</title>
	<script src="https://cdn.tailwindcss.com"></script>
	<link
		href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700;800&display=swap"
		rel="stylesheet" />
	<style>
		body.font-sans {
			font-family: 'DM Sans', sans-serif;
		}

		body .font-serif {
			font-family: 'Fraunces', serif;
		}
	</style>
</head>
}

// AdminLayout eh o layout privado de gestao
templ AdminLayout(title string, content templ.Component) {
<!DOCTYPE html>
<html lang="pt-BR">
@BaseHead(title)
<!-- fundo levemente escurecido para destacar o painel central -->

<body
	class="bg-[#e8d5c4]/40 text-[#5a262c] font-sans antialiased min-h-screen p-4 md:p-8 flex items-center justify-center">

	<!-- container principal (canto arredondado grande) -->
	<div
		class="bg-[#fdfbf9] rounded-[2rem] w-full max-w-[1400px] min-h-[calc(100vh-4rem)] shadow-xl overflow-hidden flex flex-col border border-white">

		<!-- menu horizontal -->
		<header class="flex items-center justify-between px-8 py-5 border-b border-[#e8d5c4]/30">

			<!-- logo -->
			<div class="flex items-center gap-3">
				<img src="/static/logo.png" alt="Falk Crochê" class="h-16 w-28 object-contain" />
			</div>

			<nav class="hidden lg:flex items-center gap-2 bg-[#ffeae8]/60 p-1.5 rounded-full border border-[#ffeae8]">
				@AdminNavLink("Geral", "/dashboard", title == "Visão Geral")
				@AdminNavLink("Pedidos", "/pedidos", title == "Gestão de Pedidos")
				@AdminNavLink("Produtos", "/produtos", title == "Catálogo de Produtos")
				@AdminNavLink("Clientes", "/clientes", title == "Meus Clientes")
				@AdminNavLink("Financeiro", "/financeiro", title == "Gestão Financeira")
			</nav>

			<div class="flex items-center gap-4">
				<a href="/" target="_blank"
					class="hidden md:flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold bg-white text-[#c17f6b] border border-[#e8d5c4] hover:bg-[#ffeae8] transition-colors shadow-sm">
					Vitrine Pública
				</a>
				<div
					class="h-10 w-10 rounded-full bg-[#5a262c] text-[#ffeae8] flex items-center justify-center font-bold text-lg shadow-sm">
					F</div>
				<form method="POST" action="/admin/sair">
					<button type="submit" class="text-sm font-medium text-[#5a262c] hover:underline">Sair</button>
				</form>
			</div>
		</header>

		<main class="flex-1 overflow-y-auto p-8 lg:p-12">
			<div class="max-w-7xl mx-auto">
				if title != "Visão Geral" {
				<div class="flex items-center justify-between mb-8">
					<h2 class="text-3xl font-serif font-bold text-[#5a262c]">{ title }</h2>
				</div>
				}
				@content
			</div>
		</main>
	</div>
</body>

</html>
}

templ AdminNavLink(label string, href string, ativa bool) {
if ativa {
<a href={ href } aria-current="page"
	class="px-5 py-2 rounded-full text-sm font-bold bg-[#5a262c] text-[#ffeae8] shadow-sm transition-colors">{ label
	}</a>
} else {
<a href={ href }
	class="px-5 py-2 rounded-full text-sm font-bold text-[#5a262c] hover:bg-white hover:shadow-sm transition-all duration-300">{
	label }</a>
}
}

// PublicLayout eh o layout da página publica para os clientes
templ PublicLayout(title string, content templ.Component, logoURL string) {
<!DOCTYPE html>
<html lang="pt-BR">
@BaseHead(title)

<body class="bg-[#ffeae8] text-[#5a262c] font-sans antialiased min-h-screen flex flex-col">
	<header class="px-4 pb-3 pt-6 text-center sm:pt-8">
		<img src={ logoURL } alt="Falk Crochê" class="mx-auto mb-2 h-24 w-40 object-contain sm:h-28 sm:w-48" />
		<p class="text-[#c17f6b] text-sm font-medium sm:text-base">Feito à mão, com o coração.</p>
	</header>
	<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-5 sm:px-6 sm:py-6">
		@content
	</main>
	<footer class="py-6 text-center text-xs font-medium text-[#5a262c]/60 sm:text-sm">
		&copy; 2026 Falk Crochê. Todos os direitos reservados.
	</footer>
</body>

</html>
}