package views

import "falkcroche/modelos"

templ Categorias(categorias []modelos.CategoriaProduto) {
	<div class="space-y-6">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<h3 class="text-xl font-serif font-bold text-[#5a262c]">Categorias do catálogo</h3>
				<p class="text-sm text-[#5a262c]/60">Cadastre categorias e defina a prioridade uma única vez.</p>
			</div>
			<a href="/produtos" class="rounded-lg border border-[#e8d5c4] px-4 py-2.5 text-sm font-bold text-[#5a262c] hover:bg-[#ffeae8]">Voltar aos produtos</a>
		</div>

		<form method="POST" action="/categorias/inserir" class="grid gap-3 rounded-xl border border-[#e8d5c4] bg-white p-4 sm:grid-cols-[minmax(0,1fr)_12rem_auto] sm:items-end">
			<label class="block text-sm font-semibold text-[#5a262c]">Nova categoria
				<input name="nome" type="text" maxlength="60" required placeholder="Ex.: Bolsas" class="mt-1 w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5 font-normal outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
			</label>
			<label class="block text-sm font-semibold text-[#5a262c]">Prioridade
				<select name="prioridade" class="mt-1 w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5 font-normal outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20">
					<option value="alta">Alta</option>
					<option value="media" selected>Média</option>
					<option value="baixa">Baixa</option>
				</select>
			</label>
			<button type="submit" class="rounded-lg bg-[#5a262c] px-4 py-2.5 text-sm font-bold text-[#ffeae8] hover:bg-[#472025]">Adicionar categoria</button>
		</form>

		<section class="overflow-hidden rounded-xl border border-[#e8d5c4] bg-white" aria-label="Prioridades das categorias">
			if len(categorias) == 0 {
				<div class="p-8 text-center text-sm text-[#5a262c]/60">Nenhuma categoria cadastrada.</div>
			} else {
				for _, categoria := range categorias {
					<form method="POST" action="/categorias/prioridade" class="grid gap-3 border-b border-[#e8d5c4]/70 p-4 last:border-0 sm:grid-cols-[minmax(0,1fr)_12rem_auto] sm:items-center">
						<input type="hidden" name="nome" value={ categoria.Nome } />
						<div class="min-w-0">
							<p class="truncate font-bold text-[#5a262c]">{ categoria.Nome }</p>
							<p class="text-xs text-[#5a262c]/60">Prioridade atual: { categoria.Prioridade }</p>
						</div>
						<label class="sr-only" for={ "prioridade-" + categoria.Nome }>Prioridade de { categoria.Nome }</label>
						<select id={ "prioridade-" + categoria.Nome } name="prioridade" class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-2.5">
							if categoria.Prioridade == "alta" {
								<option value="alta" selected>Alta</option>
							} else {
								<option value="alta">Alta</option>
							}
							if categoria.Prioridade == "media" {
								<option value="media" selected>Média</option>
							} else {
								<option value="media">Média</option>
							}
							if categoria.Prioridade == "baixa" {
								<option value="baixa" selected>Baixa</option>
							} else {
								<option value="baixa">Baixa</option>
							}
						</select>
						<button type="submit" class="rounded-lg border border-[#e8d5c4] px-4 py-2.5 text-sm font-semibold text-[#5a262c] hover:bg-[#ffeae8]">Salvar prioridade</button>
					</form>
				}
			}
		</section>
	</div>
}