package views

import "falkcroche/modelos"

templ Financeiro(transacoes []modelos.Transacao, entradas float64, saidas float64, saldo float64) {
<div class="space-y-6">
	<div class="grid grid-cols-1 gap-4 border-b border-[#e8d5c4] pb-5 sm:grid-cols-3">
		<div>
			<p class="mb-1 text-sm text-[#5a262c]/60">Entradas</p>
			<p class="text-2xl font-serif font-semibold text-[#7a8c5f]">{ FormatarReais(entradas) }</p>
		</div>
		<div>
			<p class="mb-1 text-sm text-[#5a262c]/60">Saídas</p>
			<p class="text-2xl font-serif font-semibold text-[#c17f6b]">{ FormatarReais(saidas) }</p>
		</div>
		<div>
			<p class="mb-1 text-sm text-[#5a262c]/60">Saldo atual</p>
			if saldo >= 0 {
			<p class="text-2xl font-serif font-semibold text-[#5a262c]">{ FormatarReais(saldo) }</p>
			} else {
			<p class="text-2xl font-serif font-semibold text-red-600">{ FormatarReais(saldo) }</p>
			}
		</div>
	</div>

	<div class="flex items-center justify-between gap-4">
		<div>
			<h3 class="text-xl font-serif font-bold text-[#5a262c]">Movimentações financeiras</h3>
			<p class="text-sm text-[#5a262c]/60">Acompanhe as entradas e saídas do ateliê.</p>
		</div>
		<button id="abrir-modal-transacao" type="button"
			class="shrink-0 rounded-lg bg-[#5a262c] px-4 py-2.5 text-sm font-bold text-[#ffeae8] hover:bg-[#472025] transition-colors">Novo
			lançamento</button>
	</div>

	<dialog id="modal-transacao"
		class="w-[min(38rem,calc(100%-2rem))] max-w-none rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-[#2b1719]/50">
		<div class="bg-white p-6 sm:p-8">
			<div class="mb-6 flex items-start justify-between gap-4">
				<div>
					<p class="mb-1 text-sm font-semibold text-[#c17f6b]">Financeiro</p>
					<h3 class="text-2xl font-serif font-bold text-[#5a262c]">Novo lançamento</h3>
				</div>
				<button id="fechar-modal-transacao" type="button" aria-label="Fechar"
					class="rounded-full px-3 py-1 text-2xl text-[#5a262c]/60 hover:bg-[#ffeae8]">&times;</button>
			</div>
			<form method="POST" action="/financeiro/inserir" class="space-y-5">
				<div>
					<label for="transacao-tipo" class="mb-1.5 block text-sm font-semibold">Tipo</label>
					<select id="transacao-tipo" name="tipo" required
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20">
						<option value="Saída" selected>Saída (Despesa)</option>
						<option value="Entrada">Entrada (Receita)</option>
					</select>
				</div>
				<div>
					<label for="transacao-descricao" class="mb-1.5 block text-sm font-semibold">Descrição</label>
					<input id="transacao-descricao" type="text" name="descricao" required
						placeholder="Ex.: Fios para produção"
						class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
				</div>
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					<div>
						<label for="transacao-valor" class="mb-1.5 block text-sm font-semibold">Valor (R$)</label>
						<input id="transacao-valor" type="number" min="0.01" step="0.01" name="valor" required
							class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
					</div>
					<div>
						<label for="transacao-data" class="mb-1.5 block text-sm font-semibold">Data</label>
						<input id="transacao-data" type="date" name="data" required
							class="w-full rounded-lg border border-[#e8d5c4] bg-[#fcf9f8] px-3 py-3 outline-none focus:border-[#5a262c] focus:ring-2 focus:ring-[#5a262c]/20" />
					</div>
				</div>
				<div class="flex justify-end gap-3 border-t border-[#e8d5c4] pt-5">
					<button id="cancelar-modal-transacao" type="button"
						class="rounded-lg border border-[#e8d5c4] px-4 py-2.5 text-sm font-semibold hover:bg-[#ffeae8]">Cancelar</button>
					<button type="submit"
						class="rounded-lg bg-[#5a262c] px-5 py-2.5 text-sm font-bold text-[#ffeae8] hover:bg-[#472025]">Registrar</button>
				</div>
			</form>
		</div>
	</dialog>

	<div class="overflow-hidden rounded-3xl border border-[#e8d5c4] bg-white shadow-sm">
		<div class="overflow-x-auto">
			<table class="w-full text-left">
				<thead class="border-b border-[#e8d5c4] bg-[#ffeae8]/40">
					<tr>
						<th class="p-5 font-bold text-[#5a262c]">Data</th>
						<th class="p-5 font-bold text-[#5a262c]">Descrição</th>
						<th class="p-5 font-bold text-[#5a262c]">Tipo</th>
						<th class="p-5 text-right font-bold text-[#5a262c]">Valor</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-[#e8d5c4]/50">
					for _, t := range transacoes {
					<tr class="hover:bg-[#ffeae8]/20 transition-colors">
						<td class="whitespace-nowrap p-5 font-medium text-[#5a262c]/80">{ t.Data }</td>
						<td class="p-5 font-bold text-[#5a262c]">{ t.Descricao }</td>
						<td class="p-5">
							if t.Tipo == "Entrada" {
							<span
								class="inline-flex items-center rounded-full bg-[#7a8c5f]/10 px-3 py-1 text-[11px] font-bold text-[#56653f]">Entrada</span>
							} else {
							<span
								class="inline-flex items-center rounded-full bg-[#c17f6b]/10 px-3 py-1 text-[11px] font-bold text-[#7d4438]">Saída</span>
							}
						</td>
						<td class="whitespace-nowrap p-5 text-right font-bold text-[#5a262c]">{ FormatarReais(t.Valor) }
						</td>
					</tr>
					}
				</tbody>
			</table>
			if len(transacoes) == 0 {
			<div class="p-10 text-center text-[#5a262c]/50 font-medium">Nenhuma movimentação financeira encontrada.
			</div>
			}
		</div>
	</div>
	<script src="/static/js/financeiro.js" defer></script>
</div>
}